# Sentinel-AI on AWS: copy to .env in the repository root ON THE EC2 SERVER
#     cp deploy/.env.aws.example .env && nano .env
# Never commit .env. Write KEY=value with no spaces around "=".

# Fixed project name so volume names are predictable (used by import_data.sh)
COMPOSE_PROJECT_NAME=sentinel-ai

# Public hostname Caddy serves over HTTPS. Without a domain, use the EC2
# public IP with dashes + .sslip.io, e.g. IP 13.201.5.20 -> 13-201-5-20.sslip.io
SITE_ADDRESS=CHANGE-ME.sslip.io

# ------------------------------------------------------------
# PostgreSQL (new on this server: pick a NEW strong password)
# ------------------------------------------------------------
POSTGRES_USER=sentinel
POSTGRES_PASSWORD=change-me
POSTGRES_DB=sentinel_db
# Same user/password as above; host is the compose service name
POSTGRES_URL=postgresql://sentinel:change-me@postgres:5432/sentinel_db

MLFLOW_TRACKING_URI=http://mlflow:5000

# ------------------------------------------------------------
# API
# ------------------------------------------------------------
# REQUIRED, long and random:
#     python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# The same value goes into Streamlit Cloud -> Settings -> Secrets
# as SENTINEL_API_KEY.
API_KEY=change-me
MODEL_PATH=model/model.pkl
FEATURES_PATH=model/features.json
METRICS_PATH=model/metrics.json

# ------------------------------------------------------------
# External services
# ------------------------------------------------------------
NVIDIA_API_KEY=
