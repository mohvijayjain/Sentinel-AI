# Sentinel-AI environment template.
#
# Copy to .env (which is gitignored) and fill in real values:
#     cp .env.example .env
# Never commit .env. Values below are placeholders, not working secrets.
# Write KEY=value with no spaces around "=".

# ------------------------------------------------------------
# PostgreSQL (docker-compose postgres service + MLflow backend store)
# ------------------------------------------------------------
# Required by docker-compose.yml. POSTGRES_PASSWORD only takes effect when
# the postgres_data volume is first initialised; changing it later does
# not change the password of an existing database.
# If the password contains URL-special characters (@ : / ? # %), they must
# be percent-encoded where it is embedded in a URL (MLflow, POSTGRES_URL).
POSTGRES_USER=sentinel
POSTGRES_PASSWORD=change-me
POSTGRES_DB=sentinel_db

# SQLAlchemy URL used by the application (src/database/postgres.py) and the
# migration runner (python -m src.database.migrate). Must match the values above.
#   from the host:        postgresql://sentinel:change-me@localhost:5432/sentinel_db
#   inside compose:       postgresql://sentinel:change-me@postgres:5432/sentinel_db
POSTGRES_URL=postgresql://sentinel:change-me@localhost:5432/sentinel_db

# ------------------------------------------------------------
# MLflow
# ------------------------------------------------------------
MLFLOW_TRACKING_URI=http://localhost:5000

# Optional. Defaults are the original names; unset = unchanged behaviour.
# Names only: artifact locations are decided by the tracking server
# (--default-artifact-root), not by these. The Champion alias is fixed.
# MLFLOW_EXPERIMENT_NAME=Sentinel-AI
# MLFLOW_REGISTERED_MODEL_NAME=sentinel-ai-champion

# docker-compose builds the MLflow server's MLFLOW_BACKEND_STORE_URI from the
# POSTGRES_* values above (passed via environment, not the command line).

# ------------------------------------------------------------
# Promotion: recent-data gate (src/training/promote.py)
# ------------------------------------------------------------
# Defaults to the container path /app/data/raw/yellow_tripdata_2026-04.parquet.
# When promoting from the host, point it at the local file instead.
# RECENT_TEST_DATA_PATH=data/raw/yellow_tripdata_2026-04.parquet
# RECENT_TEST_MONTH=April 2026

# ------------------------------------------------------------
# API / serving
# ------------------------------------------------------------
# REQUIRED. There is no built-in default: the API refuses to start without
# it. Use a long random value, e.g.
#     python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=change-me
MODEL_PATH=model/model.pkl
FEATURES_PATH=model/features.json
METRICS_PATH=model/metrics.json

# The same API_KEY (X-API-Key header) also protects /model/info,
# /monitoring/* and the Prometheus /metrics endpoint; a scraper must send
# it. /health stays public and returns only status + model_loaded.

# Browser origins allowed to call the API (CORS), comma-separated, e.g.
#     CORS_ALLOWED_ORIGINS=http://localhost:3000,https://app.example.com
# Unset or blank -> http://localhost:3000 only (local dev). "*" is refused
# at startup. Same-origin and non-browser clients are unaffected.
# CORS_ALLOWED_ORIGINS=http://localhost:3000

# ------------------------------------------------------------
# External services (RAG embeddings / LLM / alerts)
# ------------------------------------------------------------
NVIDIA_API_KEY=

# Optional NVIDIA LLM latency bounds (/chat). Worst case per answer:
#   timeout * (1 + max_retries) + max_retries * retry_delay
#   = 25 * 2 + 1 * 2 = 52s with these defaults; values above 60s are rejected
#   at startup. Only timeouts, connection errors, 429 and 500/502/503/504
#   are retried.
# NVIDIA_LLM_TIMEOUT_SECONDS=25
# NVIDIA_LLM_MAX_RETRIES=1
# NVIDIA_LLM_RETRY_DELAY_SECONDS=2

# Optional RAG relevance cutoff (/chat), as Chroma COSINE DISTANCE
# (0 = identical, smaller = more relevant, max 2). Retrieved documents
# farther than this are not given to the LLM; if none are close enough
# the answer is "information unavailable". Default 0.85; raise it if
# legitimate questions come back unavailable.
# RAG_MAX_DISTANCE=0.85
GEMINI_API_KEY=
SLACK_WEBHOOK_URL=
