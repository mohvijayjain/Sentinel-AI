# Sentinel-AI monitoring UI. Copy to frontend/.env (gitignored) or export
# the variables in your shell. Placeholders only: never commit a real key.

# Base URL of the running Sentinel-AI API (docker compose publishes :8000)
SENTINEL_API_URL=http://localhost:8000

# The API's API_KEY (sent as X-API-Key). Required for every data endpoint;
# it stays server-side in the Streamlit process and is never displayed.
SENTINEL_API_KEY=change-me

# Optional timeouts in seconds (/chat can take 20-50s)
# SENTINEL_API_TIMEOUT=10
# SENTINEL_CHAT_TIMEOUT=65
